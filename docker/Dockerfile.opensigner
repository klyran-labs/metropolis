# AgentGuard Self-Hosted OpenSigner Container
# Hardened Alpine Node.js container for sovereign agent key enclave & EIP-712 signer

FROM node:24-alpine AS builder

WORKDIR /app

# Copy package manifests for complete monorepo workspace resolution
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/package.json
COPY packages/x402-middleware/package.json ./packages/x402-middleware/package.json
COPY packages/cli/package.json ./packages/cli/package.json
COPY packages/mcp-server/package.json ./packages/mcp-server/package.json
COPY contracts/package.json ./contracts/package.json
COPY services/opensigner/package.json ./services/opensigner/package.json
COPY apps/web/package.json ./apps/web/package.json

# Copy root configs and package sources for monorepo resolution
COPY tsconfig*.json ./
COPY packages ./packages
COPY services/opensigner ./services/opensigner

# Install dependencies and build opensigner with persistent cache
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm ci --ignore-scripts
RUN npm run build --workspace=@agentguard/opensigner

FROM node:24-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3001 \
    OPENSIGNER_PORT=3001 \
    OPENSIGNER_VAULT_PATH=/data/opensigner.vault.json

# Install curl/wget for healthcheck and create non-root user
RUN apk add --no-cache wget ca-certificates && \
    mkdir -p /data /app && \
    chown -R node:node /data /app

# Copy built artifacts and production dependencies
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/services/opensigner/package.json ./services/opensigner/
COPY --from=builder /app/services/opensigner/dist ./services/opensigner/dist

USER node

VOLUME ["/data"]

EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:3001/health || exit 1

ENTRYPOINT ["node", "services/opensigner/dist/index.js"]
