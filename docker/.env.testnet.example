# ==============================================================================
# AgentGuard - Public Monad Testnet Environment Template (.env.testnet)
# Chain ID: 10143 | Monad Testnet
# Copy to docker/.env.testnet or export directly before running docker compose
# ==============================================================================

# Web, Gateway & OpenSigner Port Configuration
PORT_WEB=3110
PORT_GATEWAY=8080
PORT_OPENSIGNER=3001
OPENSIGNER_MASTER_KEY=agentguard-testnet-master-enclave-secret

# Monad Testnet RPC Endpoints
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_CHAIN_ID=10143

# Deployed Contract Addresses on Monad Testnet
# Replace with newly deployed addresses if deploying your own instance
POLICY_ENGINE_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
REPUTATION_REGISTRY_ADDRESS=0xe7f1725e7734ce288f8367e1bb143e90bb3f0512
AGENT_WALLET_GUARD_ADDRESS=0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0
USDC_TOKEN_ADDRESS=0xf817257fed379853cDe0fa4F97AB987181B1E5Ea

# Privy Authentication (App ID)
VITE_PRIVY_APP_ID=cmton65ao004l0cl11tgmwiah

# x402 Gateway Merchant & Relayer Secrets
# Merchant destination for settled agent payments
GATEWAY_MERCHANT_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
# Funded operator private key for executing AgentWalletGuard transactions
GATEWAY_RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Privy Server API Credentials & Administrative Role Controls
PRIVY_APP_ID=cmton65ao004l0cl11tgmwiah
PRIVY_APP_SECRET=
INITIAL_SUPER_ADMIN_DIDS=did:privy:your_super_admin_did_here
