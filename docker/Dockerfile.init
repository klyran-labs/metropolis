# AgentGuard Autonomous Devnet Contract Init Container
# Multi-stage build: compiles Solidity contracts via Foundry, then runs atomic Viem deployer

# Stage 1: Build Solidity contracts using Foundry
FROM ghcr.io/foundry-rs/foundry:latest AS contracts-builder

WORKDIR /app
USER root
COPY contracts ./contracts
RUN forge build --root contracts

# Stage 2: Node 24 runner
FROM node:24-alpine AS runner

WORKDIR /app
RUN apk add --no-cache wget ca-certificates

# Copy package manifests for complete monorepo workspace resolution
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/package.json
COPY packages/x402-middleware/package.json ./packages/x402-middleware/package.json
COPY packages/cli/package.json ./packages/cli/package.json
COPY packages/mcp-server/package.json ./packages/mcp-server/package.json
COPY contracts/package.json ./contracts/package.json
COPY services/opensigner/package.json ./services/opensigner/package.json
COPY apps/web/package.json ./apps/web/package.json

# Copy packages source for workspace links
COPY tsconfig*.json ./
COPY packages ./packages
COPY services/opensigner ./services/opensigner

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm ci --ignore-scripts --omit=dev

# Copy compiled artifacts from builder
COPY --from=contracts-builder /app/contracts/out ./contracts/out

# Copy deploy scripts and environments
COPY scripts ./scripts
COPY deploy ./deploy

ENV NODE_ENV=development \
    RPC_URL=http://monad-devnet:8545 \
    MONAD_RPC_URL=http://monad-devnet:8545 \
    DEPLOYMENT_MANIFEST_PATH=/app/deploy/environments/local/deployment-manifest.json

ENTRYPOINT ["node", "scripts/docker-init-contracts.mjs"]
