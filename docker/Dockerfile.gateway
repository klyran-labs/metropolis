# AgentGuard High-Throughput Rust Gateway Container
# Multi-stage Alpine build for ultra-minimal footprint and memory safety

# Stage 1: Compile Rust release binary
FROM rust:alpine AS builder

WORKDIR /app

# musl-dev, gcc, openssl-dev, openssl-libs-static, pkgconfig for static/musl compilation
RUN apk add --no-cache musl-dev gcc openssl-dev openssl-libs-static pkgconfig

# Copy manifests
COPY services/gateway/Cargo.toml services/gateway/Cargo.lock ./

# Copy source, tests, benches, migrations, and manifests
COPY services/gateway/src ./src
COPY services/gateway/tests ./tests
COPY services/gateway/benches ./benches
COPY services/gateway/migrations ./migrations
COPY deploy/environments ./deploy/environments

# Compile optimized release binary with BuildKit caching
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --bin agentguard-gateway

# Stage 2: Hardened Alpine runtime
FROM alpine:3.20 AS runner

WORKDIR /app

# CA certificates & openssl libraries for outbound HTTPS calls to Privy Server API & Monad RPCs
RUN apk add --no-cache ca-certificates tzdata wget libssl3 libcrypto3

ENV PORT=8080

# Copy binary from builder
COPY --from=builder /app/target/release/agentguard-gateway /app/agentguard-gateway
COPY --from=builder /app/deploy/environments /app/deploy/environments

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["/app/agentguard-gateway"]
