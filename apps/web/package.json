{
  "name": "@agentguard/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AgentGuard Agentic Risk & Spend Control Plane on Monad",
  "scripts": {
    "dev": "vite --port 3110",
    "build": "vite build",
    "build:tenant": "VITE_APP_TARGET=tenant vite build",
    "build:admin": "VITE_APP_TARGET=admin vite build",
    "build:all": "npm run build:tenant && npm run build:admin",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "preview": "vite preview --port 3110",
    "test": "node --test test/frontend.test.mjs"
  },
  "dependencies": {
    "@agentguard/shared-types": "^1.0.0",
    "@agentguard/x402-middleware": "*",
    "@privy-io/react-auth": "^3.40.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.12",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.42.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.56.3",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
