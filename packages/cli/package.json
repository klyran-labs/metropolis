{
  "name": "@agentguard/cli",
  "version": "1.1.0",
  "type": "module",
  "description": "Circuit Protocol CLI — Zero-Trust Financial Firewall & Clearing Layer CLI for Autonomous Machine Economies on Monad (formerly @agentguard/cli; npm scope migration per ADR-0012 deferred to v2.0 registry republish)",
  "bin": {
    "circuit": "./dist/bin.js",
    "agentguard": "./dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test test/cli.test.mjs"
  },
  "dependencies": {
    "@agentguard/shared-types": "^1.0.0",
    "commander": "^14.0.2",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
