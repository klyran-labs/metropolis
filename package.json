{
  "name": "agentguard-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AgentGuard: Agentic Risk & Spend Control Layer for Monad Metropolis",
  "workspaces": [
    "packages/*",
    "apps/*",
    "contracts"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=@agentguard/web",
    "test": "npm run typecheck && node --test contracts/test/agentguard-contracts.test.mjs apps/web/test/frontend.test.mjs packages/x402-middleware/test/middleware.test.mjs",
    "test:gateway": "cargo test --manifest-path services/gateway/Cargo.toml",
    "admin:set-role": "node scripts/set-privy-role.mjs",
    "lint": "node scripts/verify-theme-contract.mjs && npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
